DATABASE_URL=postgresql://kenko:kenko@localhost:5432/kenko
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Porta do banco do docker compose no seu computador. Troque se a 5432 já estiver em uso, por exemplo
# por um PostgreSQL instalado no sistema, e use a mesma porta na DATABASE_URL.
KENKO_DB_PORT=5432

{
  "name": "kenko-api",
  "version": "0.1.0",
  "description": "API REST do atendimento e agendamento da clínica Kenko (bot de agendamento e painel de indicadores).",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write src tests *.mts *.mjs *.json",
    "format:check": "prettier --check src tests *.mts *.mjs *.json",
    "db:migrate": "tsx src/database/migrate.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "db:seed": "tsx src/database/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devbianchi/kenko-api.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/devbianchi/kenko-api/issues"
  },
  "homepage": "https://github.com/devbianchi/kenko-api#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  }
}

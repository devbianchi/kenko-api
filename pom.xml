<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.kenko</groupId>
	<artifactId>kenko-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Kenko API</name>
	<description>API REST do sistema de atendimento e agendamento automatizado da clínica Kenko, com bot de agendamento e painel de indicadores.</description>
	<url>https://github.com/devbianchi/kenko-api</url>
	<developers>
		<developer>
			<name>Guilherme Machado</name>
		</developer>
		<developer>
			<name>Gustavo Gomes</name>
		</developer>
		<developer>
			<name>Gustavo Barguena</name>
		</developer>
		<developer>
			<name>Guilherme Pepe</name>
		</developer>
		<developer>
			<name>Flávio Betarelli</name>
		</developer>
		<developer>
			<name>Arthur Lima</name>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/devbianchi/kenko-api.git</connection>
		<developerConnection>scm:git:https://github.com/devbianchi/kenko-api.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/devbianchi/kenko-api</url>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
